{
  "entities": {
    "InterceptorJob": {
      "title": "InterceptorJob",
      "description": "High-ticket freelance job intercepted via external Python Playwright scraper or webhook receiver.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Authenticated operator UID who owns this intercepted job record.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "source": {
          "type": "string",
          "description": "Origin of the webhook payload.",
          "enum": ["playwright-scraper", "n8n-alert", "test-dispatcher"],
          "minLength": 1,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "description": "Headline of the scraped job or failure alert.",
          "minLength": 1,
          "maxLength": 240
        },
        "clientName": {
          "type": "string",
          "description": "Target enterprise or client organization.",
          "minLength": 1,
          "maxLength": 160
        },
        "budget": {
          "type": "string",
          "description": "Estimated contract value or retainer bracket.",
          "minLength": 1,
          "maxLength": 80
        },
        "jobDescription": {
          "type": "string",
          "description": "Full technical problem description from the scraped payload.",
          "minLength": 1,
          "maxLength": 8000
        },
        "webhookToken": {
          "type": "string",
          "description": "Routing token used by the webhook endpoint.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roiProposal": {
          "type": "string",
          "description": "Plain-text ROI-focused proposal generated by Gemini.",
          "minLength": 0,
          "maxLength": 12000
        },
        "status": {
          "type": "string",
          "description": "Current workflow stage of the intercepted job.",
          "enum": ["intercepted", "proposal_ready", "dispatched"],
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of job interception."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last mutation."
        }
      },
      "required": [
        "ownerId",
        "source",
        "title",
        "clientName",
        "budget",
        "jobDescription",
        "webhookToken",
        "roiProposal",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "ArbitrageRepo": {
      "title": "ArbitrageRepo",
      "description": "GitHub repository fetched and indexed for rapid client arbitrage deployment.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Authenticated operator UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "repoUrl": {
          "type": "string",
          "description": "Full GitHub URL or owner/repo identifier.",
          "minLength": 3,
          "maxLength": 300
        },
        "repoFullName": {
          "type": "string",
          "description": "Canonical owner/repo name.",
          "minLength": 3,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "description": "Arbitrage deployment category.",
          "minLength": 1,
          "maxLength": 80
        },
        "readmeContent": {
          "type": "string",
          "description": "Raw README.md content fetched from GitHub.",
          "minLength": 1,
          "maxLength": 100000
        },
        "jsonFileName": {
          "type": "string",
          "description": "Primary JSON workflow or configuration filename.",
          "minLength": 1,
          "maxLength": 200
        },
        "jsonRawContent": {
          "type": "string",
          "description": "Raw JSON payload for one-click client deployment.",
          "minLength": 2,
          "maxLength": 100000
        },
        "starsCount": {
          "type": "number",
          "description": "GitHub stargazer count at sync time."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last sync timestamp."
        }
      },
      "required": [
        "ownerId",
        "repoUrl",
        "repoFullName",
        "category",
        "readmeContent",
        "jsonFileName",
        "jsonRawContent",
        "starsCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "ColdLead": {
      "title": "ColdLead",
      "description": "Apollo.io exported lead routed through the MillionVerifier / n8n Verification Airlock.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Authenticated operator UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "description": "Prospect corporate email address.",
          "minLength": 3,
          "maxLength": 180
        },
        "firstName": {
          "type": "string",
          "description": "Prospect first name.",
          "minLength": 1,
          "maxLength": 100
        },
        "lastName": {
          "type": "string",
          "description": "Prospect last name.",
          "minLength": 1,
          "maxLength": 100
        },
        "company": {
          "type": "string",
          "description": "Hiring organization name.",
          "minLength": 1,
          "maxLength": 160
        },
        "jobTitle": {
          "type": "string",
          "description": "Prospect role title.",
          "minLength": 1,
          "maxLength": 160
        },
        "hiringSignal": {
          "type": "string",
          "description": "Detected manual data entry hiring signal from Apollo.",
          "minLength": 1,
          "maxLength": 240
        },
        "verificationStatus": {
          "type": "string",
          "description": "Verification Airlock status. Catch All and Invalid rows are purged.",
          "enum": ["Pending Airlock", "Valid"],
          "minLength": 1,
          "maxLength": 40
        },
        "assignedBurnerDomain": {
          "type": "string",
          "description": "Secondary burner domain assigned for Smartlead veil protection.",
          "enum": ["ops-apexroute.io", "cyber-relay.net", "automate-veil.org"],
          "minLength": 1,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Import timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Verification update timestamp."
        }
      },
      "required": [
        "ownerId",
        "email",
        "firstName",
        "lastName",
        "company",
        "jobTitle",
        "hiringSignal",
        "verificationStatus",
        "assignedBurnerDomain",
        "createdAt",
        "updatedAt"
      ]
    },
    "LedgerEntry": {
      "title": "LedgerEntry",
      "description": "LLC corporate veil accounting entry tracking personal capital contributions and Accountable Plan reimbursements.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Authenticated operator UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "entryType": {
          "type": "string",
          "description": "Classification under the LLC Accountable Plan.",
          "enum": ["Accountable Plan Reimbursement", "Personal Capital Contribution"],
          "minLength": 1,
          "maxLength": 64
        },
        "itemTitle": {
          "type": "string",
          "description": "Hardware or infrastructure asset description.",
          "minLength": 1,
          "maxLength": 200
        },
        "vendor": {
          "type": "string",
          "description": "Merchant or hardware supplier.",
          "minLength": 1,
          "maxLength": 120
        },
        "amountCents": {
          "type": "number",
          "description": "Exact transaction value in USD cents (e.g., 75000 for $750.00)."
        },
        "paymentMethod": {
          "type": "string",
          "description": "Personal funding instrument used (e.g., Personal Varo Card).",
          "minLength": 1,
          "maxLength": 100
        },
        "reimbursementAccount": {
          "type": "string",
          "description": "Corporate checking account issuing the payout (e.g., Relay Business Checking).",
          "minLength": 1,
          "maxLength": 100
        },
        "expenseDate": {
          "type": "string",
          "description": "ISO date of transaction.",
          "minLength": 4,
          "maxLength": 32
        },
        "receiptFileName": {
          "type": "string",
          "description": "Uploaded PDF receipt filename.",
          "minLength": 1,
          "maxLength": 180
        },
        "receiptDataUrl": {
          "type": "string",
          "description": "Base64 PDF receipt payload or storage reference.",
          "minLength": 1,
          "maxLength": 750000
        },
        "receiptSha256": {
          "type": "string",
          "description": "Cryptographic SHA-256 hash of the PDF receipt for audit verification.",
          "minLength": 8,
          "maxLength": 128
        },
        "payoutStatus": {
          "type": "string",
          "description": "Relay checking reimbursement status.",
          "enum": ["Pending Verification", "Approved for Relay Payout", "Reimbursed via Relay Checking"],
          "minLength": 1,
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Record creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last status change timestamp."
        }
      },
      "required": [
        "ownerId",
        "entryType",
        "itemTitle",
        "vendor",
        "amountCents",
        "paymentMethod",
        "reimbursementAccount",
        "expenseDate",
        "receiptFileName",
        "receiptDataUrl",
        "receiptSha256",
        "payoutStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "VrPipelineItem": {
      "title": "VrPipelineItem",
      "description": "8K 360 spatial video rendering task tracked across the 4-stage Kanban pipeline and Kaggle RIFE compute nodes.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Authenticated operator UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clipTitle": {
          "type": "string",
          "description": "Identifier for the 8K 360 capture sequence.",
          "minLength": 1,
          "maxLength": 180
        },
        "cameraSource": {
          "type": "string",
          "description": "Capture hardware (e.g., Insta360 X5).",
          "minLength": 1,
          "maxLength": 100
        },
        "nasPath": {
          "type": "string",
          "description": "Local Synology 4-Bay NAS (RAID 5) archival volume path.",
          "minLength": 1,
          "maxLength": 260
        },
        "resolution": {
          "type": "string",
          "description": "Frame dimensions and bit depth.",
          "minLength": 1,
          "maxLength": 64
        },
        "stage": {
          "type": "string",
          "description": "Current Kanban logistics column.",
          "enum": [
            "Raw 30fps Capture",
            "Topaz Cloud Interpolation",
            "Spatial Metadata Injection",
            "3D Gaussian Splatting"
          ],
          "minLength": 1,
          "maxLength": 64
        },
        "kaggleNotebookId": {
          "type": "string",
          "description": "Kaggle kernel slug running open-source RIFE interpolation.",
          "minLength": 1,
          "maxLength": 160
        },
        "rifeStatus": {
          "type": "string",
          "description": "Live compute state of the Kaggle RIFE notebook.",
          "enum": ["Idle", "Queued", "Running RIFE v4.15", "Completed"],
          "minLength": 1,
          "maxLength": 64
        },
        "targetFps": {
          "type": "string",
          "description": "Interpolated target frame rate.",
          "enum": ["60fps", "90fps", "120fps"],
          "minLength": 1,
          "maxLength": 24
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last stage transition timestamp."
        }
      },
      "required": [
        "ownerId",
        "clipTitle",
        "cameraSource",
        "nasPath",
        "resolution",
        "stage",
        "kaggleNotebookId",
        "rifeStatus",
        "targetFps",
        "createdAt",
        "updatedAt"
      ]
    },
    "BciCalibration": {
      "title": "BciCalibration",
      "description": "Wearable stack calibration mapping micro-EMG triggers and SSVEP gaze coordinates to n8n webhook URLs.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Authenticated operator UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "profileName": {
          "type": "string",
          "description": "Action name displayed in the INMO Air 3 AR holographic overlay.",
          "minLength": 1,
          "maxLength": 140
        },
        "hardwareTarget": {
          "type": "string",
          "description": "Wearable subsystem pairing.",
          "enum": ["INMO Air 3 AR + Hybrid BCI", "SSVEP Occipital Array", "Micro-EMG Surface Leads"],
          "minLength": 1,
          "maxLength": 80
        },
        "emgTrigger": {
          "type": "string",
          "description": "Specific micro-EMG muscular gesture trigger.",
          "minLength": 1,
          "maxLength": 120
        },
        "emgThresholdMicrovolts": {
          "type": "number",
          "description": "Activation threshold in microvolts (uV)."
        },
        "ssvepGazeX": {
          "type": "number",
          "description": "Horizontal AR HUD gaze coordinate (0-1920)."
        },
        "ssvepGazeY": {
          "type": "number",
          "description": "Vertical AR HUD gaze coordinate (0-1080)."
        },
        "ssvepFrequencyHz": {
          "type": "number",
          "description": "SSVEP flicker target frequency in Hz (e.g., 12.5)."
        },
        "webhookUrl": {
          "type": "string",
          "description": "Target n8n automation pipeline webhook URL.",
          "minLength": 5,
          "maxLength": 400
        },
        "payloadTemplate": {
          "type": "string",
          "description": "JSON string template dispatched when trigger fires.",
          "minLength": 2,
          "maxLength": 4000
        },
        "triggerCount": {
          "type": "number",
          "description": "Cumulative count of hands-free executions."
        },
        "lastHttpStatus": {
          "type": "number",
          "description": "HTTP status code from most recent webhook execution."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last calibration or fire timestamp."
        }
      },
      "required": [
        "ownerId",
        "profileName",
        "hardwareTarget",
        "emgTrigger",
        "emgThresholdMicrovolts",
        "ssvepGazeX",
        "ssvepGazeY",
        "ssvepFrequencyHz",
        "webhookUrl",
        "payloadTemplate",
        "triggerCount",
        "lastHttpStatus",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/interceptorJobs/{jobId}": {
      "schema": { "$ref": "#/entities/InterceptorJob" },
      "description": "Stores real-time intercepted freelance jobs and Gemini-generated ROI proposals."
    },
    "/arbitrageRepos/{repoId}": {
      "schema": { "$ref": "#/entities/ArbitrageRepo" },
      "description": "Stores fetched GitHub README.md and raw JSON templates for client arbitrage."
    },
    "/coldLeads/{leadId}": {
      "schema": { "$ref": "#/entities/ColdLead" },
      "description": "Stores Apollo.io leads scrubbed through the MillionVerifier / n8n Verification Airlock."
    },
    "/ledgerEntries/{entryId}": {
      "schema": { "$ref": "#/entities/LedgerEntry" },
      "description": "Stores LLC Accountable Plan reimbursements, PDF receipts, and Relay payout states."
    },
    "/vrPipelineItems/{itemId}": {
      "schema": { "$ref": "#/entities/VrPipelineItem" },
      "description": "Stores 8K 360 VR pipeline items and Kaggle RIFE interpolation states."
    },
    "/bciCalibrations/{calibrationId}": {
      "schema": { "$ref": "#/entities/BciCalibration" },
      "description": "Stores micro-EMG and SSVEP gaze coordinate mappings to n8n webhook endpoints."
    }
  }
}
